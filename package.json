{
  "name": "discordbot",
  "version": "2.0.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "commands": "node dist/bot/deployCommands.js",
    "restart": "npm run build && sudo systemctl restart discordbot"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
