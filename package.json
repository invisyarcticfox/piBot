{
  "name": "discordbot",
  "version": "2.1.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf ./dist && tsc && tsc-alias",
    "commands": "node dist/bot/commands/deploy.js",
    "restart": "npm run build && sudo systemctl restart discordbot"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
